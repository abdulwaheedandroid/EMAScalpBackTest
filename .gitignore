# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and packaging
build/
dist/
*.egg-info/
.eggs/

# IDE settings
.vscode/
.idea/
.cursor/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Secrets and environment variables
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Local/private configuration
local_settings.py
config.local.py
secrets.py

# Logs
*.log
logs/

# Test and analysis caches
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# Downloaded market data
data/*.csv
data/*.parquet
data/*.json
